---
const title = "About — SpatialGround";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="The research and environmental GIS perspective behind SpatialGround." />
    <link rel="icon" type="image/svg+xml" href="/spatialground-sr-topography.svg" />
  </head>
<body>
  <main>
    <nav><a href="/prototype/">← BACK TO SELECTED WORK</a><span>SPATIALGROUND</span></nav>
    <section class="intro">
      <p class="eyebrow">BEHIND SPATIALGROUND</p>
      <h1>Mapping landscapes.<br/><em>Informing decisions.</em></h1>
      <p class="lead">SpatialGround is a portfolio exploring environmental challenges through GIS, spatial analysis, natural resource management, and environmental policy.</p>
      <!-- sg-about-hero-v4: portrait beside the opening statement -->
      <figure class="sg-about-hero-v4">
        <img src="/images/about-profile.png" alt="Researcher visiting a Yellowstone geothermal landscape" width="1536" height="1024" loading="eager" decoding="async" />
        <figcaption>FIELD EXPERIENCE <span>Â·</span> YELLOWSTONE NATIONAL PARK</figcaption>
      </figure>
      <div class="line"></div>
      <h2>About the researcher</h2>
      <p>As an environmental studies scholar, I am pursuing my master’s degree from the University of Denver in the subject of Environmental Policy and Management, with specialization in Natural Resource Management. My academic and professional expertise lies in Geographic Information Systems (GIS).</p>
      <p>The use of spatial data to comprehend environmental problems, evaluate natural hazards, study the suitability of a habitat, and manage resources is my field of research.</p>
      <p>SpatialGround is my collection of GIS projects that combines the knowledge of spatial analysis, environmental science, and policy implications.</p>
      <a class="return" href="/prototype/">EXPLORE THE PROJECTS →</a>
    </section>
  </main>
</body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(html),:global(body){margin:0;min-height:100%;background:#171c1d;color:#f1eadc}
  :global(body){font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:linear-gradient(130deg,rgba(15,20,22,.90),rgba(22,25,25,.87)),url('/images/richat-bright-v2.jpg') center/cover fixed}
  main{max-width:1100px;margin:auto;padding:35px clamp(24px,5vw,65px) 90px}
  nav{display:flex;justify-content:space-between;gap:20px;align-items:center;font-size:.65rem;letter-spacing:.19em}
  nav a,.return{color:#e4c894;text-decoration:none} nav span{font-family:Georgia,serif;letter-spacing:.32em}
  a:hover{text-decoration:underline}a:focus-visible{outline:2px solid #e4c894;outline-offset:5px}
  .intro{max-width:740px;margin:clamp(80px,13vh,160px) 0 0}
  .eyebrow{font-size:.68rem;letter-spacing:.28em;color:#ddc391}
  h1{font-family:Georgia,serif;font-size:clamp(2.6rem,6vw,5.2rem);font-weight:400;line-height:1.08;margin:24px 0}
  h1 em{font-weight:400;color:#d8bb8b}
  .lead{font-size:clamp(1.06rem,1.6vw,1.3rem);line-height:1.75;color:#e3dfd6}
  .line{height:1px;background:rgba(227,202,158,.4);margin:45px 0 35px}
  h2{font-family:Georgia,serif;font-size:1.8rem;font-weight:400}
  p{line-height:1.85;color:#d4d0c7}
  .return{display:inline-block;margin-top:32px;font-size:.7rem;letter-spacing:.17em}
  /* sg-about-hero-v4: photo at upper right, research copy below */
  .intro{position:relative;max-width:none;min-height:0}
  .intro > .eyebrow,.intro > h1,.intro > .lead{max-width:52%}
  .sg-about-hero-v4{position:absolute;top:0;right:0;width:43%;margin:0}
  .sg-about-hero-v4 img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;border:1px solid rgba(228,200,148,.42);border-radius:5px;box-shadow:0 22px 55px rgba(0,0,0,.35)}
  .sg-about-hero-v4 figcaption{margin-top:13px;color:#e4c894;font-size:.64rem;letter-spacing:.16em;line-height:1.6}
  .sg-about-hero-v4 figcaption span{padding:0 .35em}
  .intro > .line{margin-top:clamp(85px,10vw,155px)}
  .intro > h2,.intro > p:not(.eyebrow):not(.lead){max-width:740px}
  /* Previous V3 photo layout is retired; its researcher text stays intact. */
  .sg-about-photo-v3{display:block!important;margin-top:0!important}
  .sg-about-photo-v3 .sg-profile-figure{display:none!important}
  .sg-about-photo-v3 .sg-profile-copy{max-width:740px}
  @media(max-width:800px){
    .intro > .eyebrow,.intro > h1,.intro > .lead{max-width:none}
    .sg-about-hero-v4{position:static;width:100%;max-width:700px;margin:28px 0 0}
    .intro > .line{margin-top:38px}
  }
</style>
