<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SpatialGround — 9-Card Compressed-Rear Prototype</title>
  </head>

  <body>
    <main class="stage">
      <div class="topography"></div>
      <div class="vignette"></div>

      <header>
        <div>
          <div class="brand">SPATIALGROUND</div>
          <div class="subbrand">
            GIS · NATURAL RESOURCES · ENVIRONMENTAL POLICY
          </div>
        </div>

        <div class="prototype">9-CARD COMPRESSED-REAR PROTOTYPE</div>
      </header>

      <section class="work">
        <div class="section-label">SELECTED WORK</div>

        <div class="scene" id="scene">
          <div class="cylinder" id="cylinder">
            {
              projects.map((project, index) => (
                <article
                  class={`card ${project.className}`}
                  data-index={index}
                >
                  {index === 0 ? (
                    <iframe class="hawaii-v7-frame" src="/hawaii-v7-ring.html" title="Hawaiʻi Island V7 animated artwork" tabindex="-1" aria-hidden="true"></iframe>
                  ) : (
                    <div class="visual"></div>
                  )}
                  {index !== 0 && <div class="shade"></div>}

                  <div class={index === 0 ? "content lava-original-hidden" : "content"}>
                    <div class="number">{project.number}</div>

                    <div class="card-bottom">
                      <div class="location">{project.location}</div>
                      <h2>{project.title}</h2>
                      <div class="rule"></div>
                      <p>{project.tags}</p>
                      <div class="view">{index === 0 ? "VIEW PROJECT →" : "COMING SOON"}</div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="floor"></div>
        </div>

        <div class="controls">
          <button id="prev" aria-label="Previous project">←</button>

          <div class="dots" id="dots">
            {
              projects.map((_, index) => (
                <button
                  class="dot"
                  data-index={index}
                  aria-label={`Go to project ${index + 1}`}
                ></button>
              ))
            }
          </div>

          <button id="next" aria-label="Next project">→</button>
        </div>

        <div class="instruction">
          DRAG · SCROLL · USE ← →
        </div>
      </section>
    </main>

    <script>
      const cards = Array.from(document.querySelectorAll(".card"));
      const dots = Array.from(document.querySelectorAll(".dot"));
      const scene = document.getElementById("scene");
      const prev = document.getElementById("prev");
      const next = document.getElementById("next");

      const count = cards.length;
      let current = 0;



      function shortestDistance(index, active) {
        let diff = index - active;

        if (diff > count / 2) diff -= count;
        if (diff < -count / 2) diff += count;

        return diff;
      }

      function updateCards() {
        const compact = window.innerWidth <= 850;

        // Nine-slot tilted exhibition ring.
        // The two deepest cards sit side-by-side at the rear instead
        // of converging into one centered apex.
        const radiusX = compact ? 400 : 835;
        const radiusZ = compact ? 575 : 1000;
        const rise = compact ? 150 : 235;

        cards.forEach((card, index) => {
          const diff = shortestDistance(index, current);
          const absDiff = Math.abs(diff);

          // 9 cards => symmetric signed distances -4...+4.
          // ±4 are the two deepest rear cards and are deliberately
          // kept apart so they form a rear pair.
          const angleMap = compact
            ? [0, 38, 74, 108, 148]
            : [0, 38, 73, 106, 146];

          const angle =
            diff === 0 ? 0 : Math.sign(diff) * angleMap[absDiff];

          const rad = angle * Math.PI / 180;

          // Preserve the existing ring's Y/Z geometry.
          // On desktop/tablet only, compress the REAR cards horizontally
          // toward the center, matching the inward arrows in the screenshot.
          // Mobile stays exactly as before.
          const baseX = Math.sin(rad) * radiusX;

          const rearXCompression =
            compact
              ? 1
              : absDiff === 4
                ? 0.60
                : absDiff === 3
                  ? 0.80
                  : 1;

          const x = baseX * rearXCompression;
          const z = (Math.cos(rad) - 1) * radiusZ;
          const y = (1 - Math.cos(rad)) * rise;

          const depth = Math.max(
            0,
            Math.min(1, -z / (radiusZ * 1.35))
          );

          const scale = 1 - depth * 0.30;
          const opacity = 1 - depth * 0.47;
          const brightness = 1 - depth * 0.33;
          const blur = depth * 1.0;

          // Keep every card readable/front-facing. Only a tiny yaw
          // hints at curvature; the rear pair is not mirrored.
          const faceYaw =
            diff === 0
              ? 0
              : Math.sign(diff) * Math.min(5, absDiff * 1.2);

          const rotateX = Math.min(4.5, absDiff * 1.0);

          card.style.transform = `
            translate(-50%, -50%)
            translate3d(${x}px, ${-y}px, ${z}px)
            rotateY(${faceYaw}deg)
            rotateX(${rotateX}deg)
            scale(${scale})
          `;

          card.style.opacity = opacity.toString();
          card.style.filter = `brightness(${brightness}) blur(${blur}px)`;
          card.style.zIndex = String(Math.round(4000 + z));
          const wasActive = card.classList.contains("active");
          card.classList.toggle("active", diff === 0);
          if (diff === 0 && !wasActive && index === 0) {
            card.querySelector("iframe")?.contentWindow?.postMessage("spatialground:replay-v7", "*");
          }
        });

        dots.forEach((dot, index) => {
          dot.classList.toggle("active", index === current);
        });
      }

      function normalizeCurrent() {
        current = ((current % count) + count) % count;
      }

      function goTo(index) {
        current = index;
        normalizeCurrent();
        updateCards();
      }

      function step(direction) {
        goTo(current + direction);
      }

      prev?.addEventListener("click", () => step(-1));
      next?.addEventListener("click", () => step(1));

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => goTo(index));
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") step(-1);
        if (event.key === "ArrowRight") step(1);
      });

      let wheelLock = false;

      scene?.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();

          if (wheelLock) return;

          wheelLock = true;

          const movement =
            Math.abs(event.deltaX) > Math.abs(event.deltaY)
              ? event.deltaX
              : event.deltaY;

          if (movement > 0) step(1);
          if (movement < 0) step(-1);

          setTimeout(() => {
            wheelLock = false;
          }, 420);
        },
        { passive: false }
      );

      // Interaction MASTER: one pointer gesture, one action.
      // Hit testing uses the browser's frontmost painted element; never
      // search card rectangles, which would click through overlapping cards.
      const DRAG_THRESHOLD = 9;
      let press = null;
      let suppressClickUntil = 0;

      function hitCard(event) {
        const element = document.elementFromPoint(event.clientX, event.clientY);
        const card = element instanceof Element ? element.closest(".card") : null;
        return card && scene?.contains(card) ? card : null;
      }

      function activateCard(index) {
        if (!Number.isInteger(index) || index < 0 || index >= count) return;
        if (index !== current) {
          goTo(index); // A visible side/rear card becomes active immediately.
        } else if (index === 0) {
          window.location.assign("/projects/hawaii-lava-risk/");
        }
      }

      scene?.addEventListener("pointerdown", (event) => {
        if (press || !event.isPrimary || (event.pointerType === "mouse" && event.button !== 0)) return;
        const card = hitCard(event);
        press = {
          id: event.pointerId,
          index: card ? Number(card.dataset.index) : null,
          x: event.clientX,
          y: event.clientY,
          start: current,
          dragged: false,
          captured: false
        };
      }, true);

      document.addEventListener("pointermove", (event) => {
        if (!press || event.pointerId !== press.id) return;
        const dx = event.clientX - press.x;
        const dy = event.clientY - press.y;
        if (!press.dragged && Math.hypot(dx, dy) > DRAG_THRESHOLD) {
          press.dragged = true;
          scene?.classList.add("dragging");
          try {
            scene?.setPointerCapture(event.pointerId);
            press.captured = !!scene?.hasPointerCapture(event.pointerId);
          } catch (_) { /* Pointer capture can fail on cancelled gestures. */ }
        }
        if (press.dragged && Math.abs(dx) > 75) {
          current = press.start + Math.round(-dx / 180);
          normalizeCurrent();
          updateCards();
        }
      }, true);

      document.addEventListener("pointerup", (event) => {
        if (!press || event.pointerId !== press.id) return;
        const finished = press;
        press = null;
        scene?.classList.remove("dragging");
        if (finished.captured && scene?.hasPointerCapture(event.pointerId)) {
          scene.releasePointerCapture(event.pointerId);
        }
        // Prevent a second activation from the browser's subsequent click.
        suppressClickUntil = performance.now() + 500;
        const travel = Math.hypot(event.clientX - finished.x, event.clientY - finished.y);
        if (!finished.dragged && travel <= DRAG_THRESHOLD && finished.index !== null) {
          activateCard(finished.index);
        }
      }, true);

      document.addEventListener("pointercancel", (event) => {
        if (!press || event.pointerId !== press.id) return;
        press = null;
        scene?.classList.remove("dragging");
      }, true);

      // Keyboard-generated click only. Physical mouse/touch/pen clicks
      // were already handled on pointerup, even during CSS transitions.
      scene?.addEventListener("click", (event) => {
        if (event.detail !== 0 || performance.now() < suppressClickUntil) return;
        const card = event.target instanceof Element ? event.target.closest(".card") : null;
        if (card) activateCard(Number(card.dataset.index));
      });

      updateCards();
    </script>
  </body>
</html>

