}
.placeholderSix .location, .placeholderSeven .location, .placeholderEight .location, .placeholderNine .location {color:#e9d5ae !important;}
/* Clearly distinguish unreleased projects, without changing card sizes. */
.card:not(.lava) .view {color:#f0d5a6; letter-spacing:.18em;}
.card:not(.lava) {cursor:grab;}
/* Keep controls legible on the bright desert. */
.brand, .section-label {text-shadow:0 2px 12px rgba(0,0,0,.75);}
.subbrand, .prototype, .instruction {color:#e1d6c2 !important; text-shadow:0 1px 7px rgba(0,0,0,.9);}
.controls {filter:drop-shadow(0 2px 6px rgba(0,0,0,.8));}

/* SG-CYLINDER-HITTEST-FIX-START */
/* Allow actual painted cards to receive pointer events without the
   transformed cylinder surface swallowing hits in empty/overlap areas. */
