  {
    number: "01",
    location: "HAWAIʻI",
    title: "Lava Hazard Analysis",
    tags: "Natural Hazards · Spatial Analysis · Risk Assessment",
    className: "lava",
  },
  {
    number: "02",
    location: "SAMISH BAY",
    title: "Marsh Migration",
    tags: "Sea-Level Rise · Conservation GIS · Spatial Planning",
    className: "marsh",
  },
  {
    number: "03",
    location: "PUBLIC LANDS",
    title: "Multiple-Use Management",
    tags: "Environmental Policy · BLM · FLPMA",
    className: "lands",
  },
  {
    number: "04",
    location: "NATURAL RESOURCES",
    title: "Habitat Suitability",
    tags: "Spatial Modeling · GIS · Multi-Criteria Analysis",
    className: "habitat",
  },
  {
    number: "05",
    location: "FIELD MONITORING",
    title: "Drone + GIS",
    tags: "Remote Sensing · Monitoring · Natural Resources",
    className: "drone",
  },
  {
    number: "06",
    location: "PROJECT PLACEHOLDER",
    title: "Future Project",
    tags: "Temporary card · Geometry test",
    className: "placeholderSix",
  },
  {
    number: "07",
    location: "PROJECT PLACEHOLDER",
    title: "Future Project",
    tags: "Temporary card · Geometry test",
    className: "placeholderSeven",
  },
  {
    number: "08",
    location: "PROJECT PLACEHOLDER",
    title: "Future Project",
    tags: "Temporary card · Geometry test",
    className: "placeholderEight",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SpatialGround — 8-Card Ring Prototype</title>
  </head>

  <body>
    <main class="stage">
      <div class="topography"></div>
      <div class="vignette"></div>

      <header>
        <div>
          <div class="brand">SPATIALGROUND</div>
          <div class="subbrand">
            GIS · NATURAL RESOURCES · ENVIRONMENTAL POLICY
          </div>
        </div>

        <div class="prototype">8-CARD RING PROTOTYPE</div>
      </header>

      <section class="work">
        <div class="section-label">SELECTED WORK</div>

        <div class="scene" id="scene">
          <div class="cylinder" id="cylinder">
            {
              projects.map((project, index) => (
                <article
                  class={`card ${project.className}`}
                  data-index={index}
                >
                  <div class="visual"></div>
                  <div class="shade"></div>

                  <div class="content">
                    <div class="number">{project.number}</div>

                    <div class="card-bottom">
                      <div class="location">{project.location}</div>
                      <h2>{project.title}</h2>
                      <div class="rule"></div>
                      <p>{project.tags}</p>
                      <div class="view">VIEW PROJECT →</div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="floor"></div>
        </div>

        <div class="controls">
          <button id="prev" aria-label="Previous project">←</button>

          <div class="dots" id="dots">
            {
              projects.map((_, index) => (
                <button
                  class="dot"
                  data-index={index}
                  aria-label={`Go to project ${index + 1}`}
                ></button>
              ))
            }
          </div>

          <button id="next" aria-label="Next project">→</button>
        </div>

        <div class="instruction">
          DRAG · SCROLL · USE ← →
        </div>
      </section>
    </main>

    <script>
      const cards = Array.from(document.querySelectorAll(".card"));
      const dots = Array.from(document.querySelectorAll(".dot"));
      const scene = document.getElementById("scene");
      const prev = document.getElementById("prev");
      const next = document.getElementById("next");

      const count = cards.length;

      let current = 0;
      let rotation = 0;
      let targetRotation = 0;

      let dragging = false;
      let startX = 0;
      let startRotation = 0;

      const spacing = 32;

      function shortestDistance(index, active) {
        let diff = index - active;

        if (diff > count / 2) diff -= count;
        if (diff < -count / 2) diff += count;

        return diff;
      }

      function updateCards() {
        const compact = window.innerWidth <= 850;

        // Eight-slot tilted exhibition ring.
        // One active/front card, three cards climbing each side,
        // and one card at the deepest rear apex.
        const radiusX = compact ? 400 : 835;
        const radiusZ = compact ? 575 : 1000;
        const rise = compact ? 150 : 235;

        cards.forEach((card, index) => {
          const diff = shortestDistance(index, current);
          const absDiff = Math.abs(diff);

          // With 8 cards, diff=4 is the unique rear apex.
          // Keep it centered behind the active/front card.
          const angleMap = compact
            ? [0, 42, 82, 122, 180]
            : [0, 41, 80, 120, 180];

          let angle = 0;

          if (absDiff === 4) {
            angle = 180;
          } else if (diff !== 0) {
            angle = Math.sign(diff) * angleMap[absDiff];
          }

          const rad = angle * Math.PI / 180;

          const x = Math.sin(rad) * radiusX;
          const z = (Math.cos(rad) - 1) * radiusZ;
          const y = (1 - Math.cos(rad)) * rise;

          const depth = Math.max(
            0,
            Math.min(1, -z / (radiusZ * 1.35))
          );

          const scale = 1 - depth * 0.30;
          const opacity = 1 - depth * 0.48;
          const brightness = 1 - depth * 0.34;
          const blur = depth * 1.05;

          // All project faces remain readable/front-facing.
          // Only a very small yaw is used to suggest the ring.
          const faceYaw =
            absDiff === 4 || diff === 0
              ? 0
              : Math.sign(diff) * Math.min(5, absDiff * 1.35);

          const rotateX = Math.min(4.5, absDiff * 1.05);

          card.style.transform = `
            translate(-50%, -50%)
            translate3d(${x}px, ${-y}px, ${z}px)
            rotateY(${faceYaw}deg)
            rotateX(${rotateX}deg)
            scale(${scale})
          `;

          card.style.opacity = opacity.toString();
          card.style.filter = `brightness(${brightness}) blur(${blur}px)`;
          card.style.zIndex = String(Math.round(4000 + z));
          card.classList.toggle("active", diff === 0);
        });

        dots.forEach((dot, index) => {
          dot.classList.toggle("active", index === current);
        });
      }

      function normalizeCurrent() {
        current = ((current % count) + count) % count;
      }

      function goTo(index) {
        current = index;
        normalizeCurrent();
        targetRotation = current * spacing;
        updateCards();
      }

      function step(direction) {
        goTo(current + direction);
      }

      prev?.addEventListener("click", () => step(-1));
      next?.addEventListener("click", () => step(1));

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => goTo(index));
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") step(-1);
        if (event.key === "ArrowRight") step(1);
      });

      let wheelLock = false;

      scene?.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();

          if (wheelLock) return;

          wheelLock = true;

          const movement =
            Math.abs(event.deltaX) > Math.abs(event.deltaY)
              ? event.deltaX
              : event.deltaY;

          if (movement > 0) step(1);
          if (movement < 0) step(-1);

          setTimeout(() => {
            wheelLock = false;
          }, 420);
        },
        { passive: false }
      );

      scene?.addEventListener("pointerdown", (event) => {
        dragging = true;
        startX = event.clientX;
        startRotation = current;
        scene.setPointerCapture(event.pointerId);
        scene.classList.add("dragging");
      });

      scene?.addEventListener("pointermove", (event) => {
        if (!dragging) return;

        const distance = event.clientX - startX;

        if (Math.abs(distance) > 75) {
          const movement = Math.round(-distance / 180);
          current = startRotation + movement;
          normalizeCurrent();
          updateCards();
        }
      });

      scene?.addEventListener("pointerup", (event) => {
        dragging = false;
        scene.releasePointerCapture(event.pointerId);
        scene.classList.remove("dragging");
      });

      scene?.addEventListener("pointercancel", () => {
        dragging = false;
        scene.classList.remove("dragging");
      });

      updateCards();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
    background: #071016;
  }

  :global(body) {
    overflow: hidden;
    color: #f1eee4;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  button {
    font: inherit;
  }

  .stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;

