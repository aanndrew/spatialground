    border: 1px solid rgba(176, 176, 142, 0.2);
    border-radius: 50%;

    box-shadow:
      inset 0 0 80px rgba(133, 143, 123, 0.06);
  }

  .controls {
    position: absolute;
    z-index: 400;

    bottom: 50px;
    left: 50%;

    display: flex;
    align-items: center;
    gap: 28px;

    transform: translateX(-50%);
  }

  .controls > button {
    width: 40px;
    height: 40px;

    border: 0;
    background: transparent;

    color: #d7d6cc;

    font-size: 1.4rem;

    cursor: pointer;
  }

  .dots {
    display: flex;
    gap: 12px;
  }

  .dot {
    width: 6px;
    height: 6px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: #465057;

    cursor: pointer;

    transition:
