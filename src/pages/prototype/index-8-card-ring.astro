      radial-gradient(
        circle at 70% 52%,
        rgba(181, 45, 24, 0.65),
        transparent 20%
      ),
      linear-gradient(
        125deg,
        #07141b 5%,
        #152d34 40%,
        #4c251c 72%,
        #121516 100%
      );
  }

  .marsh .visual {
    background:
      radial-gradient(
        ellipse at 70% 60%,
        #49684d 0%,
        #253f38 24%,
        transparent 48%
      ),
