      background 300ms ease;
  }

  .dot.active {
    transform: scale(1.35);
    background: #ded9bd;
  }

  .instruction {
    position: absolute;

    right: 42px;
    bottom: 58px;

    color: #6f7a7f;

    font-size: 0.56rem;
    letter-spacing: 0.25em;
  }

  @media (max-width: 850px) {
    header {
      top: 24px;
      left: 22px;
      right: 22px;
    }

    .subbrand,
    .prototype {
      display: none;
    }

    .brand {
      font-size: 0.9rem;
    }

    .section-label {
      top: 88px;
    }

    .scene {
      inset: 110px 0 100px;
      perspective: 1050px;
      perspective-origin: 50% 36%;
    }

    .card {
      width: min(78vw, 540px);
      height: min(62vh, 600px);
    }

    .content {
      padding: 28px;
    }

    .card-bottom {
      max-width: 90%;
    }

    .instruction {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition-duration: 0.01ms;
    }
  }
</style>