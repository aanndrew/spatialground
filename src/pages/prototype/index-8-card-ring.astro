      radial-gradient(
        circle at 50% 44%,
        #162634 0%,
        #0b151d 35%,
        #050b10 72%
      );
  }

  .topography {
    position: absolute;
    inset: 0;
    opacity: 0.22;

    background:
      repeating-radial-gradient(
        ellipse at 50% 105%,
        transparent 0,
        transparent 43px,
        rgba(181, 176, 139, 0.13) 44px,
        transparent 45px
      );
  }

  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;

    background:
      radial-gradient(
        circle at center,
        transparent 35%,
        rgba(0, 0, 0, 0.72) 110%
      );
  }

  header {
    position: absolute;
    z-index: 500;
    top: 34px;
    left: 42px;
    right: 42px;

    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .brand {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    letter-spacing: 0.36em;
  }

  .subbrand {
    margin-top: 10px;

    color: #7e8b91;

    font-size: 0.62rem;
    letter-spacing: 0.28em;
  }

  .prototype {
    color: #9d9878;
    font-size: 0.58rem;
    letter-spacing: 0.28em;
  }

  .work {
    position: relative;
    min-height: 100svh;
  }

  .section-label {
    position: absolute;
    z-index: 300;

    top: 118px;
    left: 50%;

    transform: translateX(-50%);

    color: #b9b181;

    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.35em;
  }

  .scene {
    position: absolute;

    inset: 145px 0 105px;

    perspective: 1350px;
    perspective-origin: 50% 38%;

    cursor: grab;
    user-select: none;
    touch-action: pan-y;
  }

  .scene.dragging {
    cursor: grabbing;
  }

  .cylinder {
    position: absolute;
    inset: 0;

    transform-style: preserve-3d;
    transform: rotateX(-7deg) translateY(18px);
    transform-origin: 50% 58%;
  }

  .card {
    position: absolute;

    top: 49%;
    left: 50%;

    width: min(650px, 43vw);
    height: min(610px, 64vh);

    overflow: hidden;

    border: 1px solid rgba(184, 191, 184, 0.25);
    border-radius: 2px;

    background: #101a20;

    transform-style: preserve-3d;
    transform-origin: center;

    transition:
      transform 850ms cubic-bezier(0.18, 0.82, 0.18, 1),
      opacity 700ms ease,
      filter 700ms ease,
      border-color 700ms ease,
      box-shadow 700ms ease;

    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.45);
  }

  .card.active {
    border-color: rgba(214, 205, 155, 0.48);

    box-shadow:
      0 45px 110px rgba(0, 0, 0, 0.7),
      0 0 50px rgba(154, 164, 145, 0.07);
  }

  .visual,
  .shade {
    position: absolute;
    inset: 0;
  }

  /*
    Temporary project visuals.
    Later these become your real GIS maps / project artwork.
  */

  .lava .visual {
