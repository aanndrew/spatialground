---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>SpatialGround | GIS & Environmental Portfolio</title>

  <meta
    name="description"
    content="SpatialGround is a GIS, natural resources, and environmental policy portfolio focused on spatial analysis and environmental decision-making."
  />
</head>

<body>
  <main class="hero">
    <div class="shade"></div>

    <div class="page">
      <header class="brand">
        <div class="logo">SG</div>
        <div class="name">SPATIALGROUND</div>
      </header>

      <section class="intro">
        <p class="eyebrow">
          GIS · NATURAL RESOURCES · ENVIRONMENTAL POLICY
        </p>

        <div class="accent"></div>

        <h1>
          Mapping the ground for
          <span>better environmental decisions.</span>
        </h1>

        <p class="description">
          SpatialGround is a portfolio exploring spatial analysis,
          natural resource management, environmental policy, and
          data-driven approaches to understanding landscapes.
        </p>

        <div class="coming">
          <span class="line"></span>
          <span>Portfolio Coming Soon</span>
        </div>
      </section>

      <footer>
        <span>© {year} SpatialGround</span>
        <span>San Francisco Bay Area · California</span>
      </footer>
    </div>
  </main>
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
  }

  :global(body) {
    background: #171b17;
    color: #eeeade;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;

    background-image: url("/images/spatialground-hero.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .shade {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(15, 20, 17, 0.50) 0%,
        rgba(15, 20, 17, 0.25) 42%,
        rgba(15, 20, 17, 0.03) 72%
      );
  }

  .page {
    position: relative;
    z-index: 1;

    width: min(1380px, calc(100% - 100px));
    min-height: 100svh;
    margin: 0 auto;
    padding: 70px 0 40px;

    display: flex;
    flex-direction: column;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .logo {
    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    border: 1px solid #b9af78;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;

    color: #eeeade;
  }

  .name {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.18rem;
    letter-spacing: 0.32em;
    color: #eeeade;
  }

  .intro {
    margin: auto 0;
    max-width: 760px;
    padding: 65px 0;
  }

  .eyebrow {
    margin: 0;

    color: #bdb27a;

    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.23em;
  }

  .accent {
    width: 38px;
    height: 1px;

    margin: 22px 0 18px;

    background: #b9ad6c;
  }

  h1 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.7rem, 5.3vw, 6.2rem);
    font-weight: 400;

    line-height: 0.98;
    letter-spacing: -0.045em;

    text-wrap: balance;
  }

  h1 span {
    color: #c7bc83;
  }

  .description {
    max-width: 620px;

    margin: 34px 0 0;

    color: #c0c1ba;

    font-size: 1rem;
    line-height: 1.75;
  }

  .coming {
    display: flex;
    align-items: center;
    gap: 26px;

    margin-top: 44px;

    color: #c8bd7d;

    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.26em;

    text-transform: uppercase;
  }

  .line {
    width: 58px;
    height: 1px;

    background: #c8bd7d;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 30px;

    color: #a6a89f;

    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  @media (max-width: 800px) {
    .hero {
      background-position: 60% center;
    }

    .shade {
      background:
        linear-gradient(
          90deg,
          rgba(15, 20, 17, 0.78) 0%,
          rgba(15, 20, 17, 0.57) 65%,
          rgba(15, 20, 17, 0.25) 100%
        );
    }

    .page {
      width: calc(100% - 40px);
      padding: 32px 0 24px;
    }

    .brand {
      gap: 16px;
    }

    .logo {
      width: 46px;
      height: 46px;
      font-size: 1.05rem;
    }

    .name {
      font-size: 0.82rem;
      letter-spacing: 0.24em;
    }

    .intro {
      padding: 60px 0;
    }

    .eyebrow {
      max-width: 330px;
      line-height: 1.8;
    }

    h1 {
      font-size: clamp(3.1rem, 13vw, 5rem);
    }

    .description {
      max-width: 520px;
      font-size: 0.94rem;
    }

    footer {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>